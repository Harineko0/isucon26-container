[Unit]
Description=ISUReal PostgreSQL transaction pool
Wants=network-online.target postgresql@16-main.service
After=network-online.target postgresql@16-main.service

[Service]
User=isucon
Group=isucon
EnvironmentFile=/home/isucon/env.sh
RuntimeDirectory=isureal-db-pool
RuntimeDirectoryMode=0700
ExecStart=/bin/bash /usr/local/libexec/isureal-db-pool
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
