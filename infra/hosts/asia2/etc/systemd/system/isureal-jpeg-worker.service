[Unit]
Description=ISUReal Asia overflow JPEG validation
Wants=network-online.target
After=network-online.target

[Service]
User=isucon
Group=isucon
EnvironmentFile=/home/isucon/env.sh
Environment=ISUREAL_JPEG_LISTEN=192.168.4.10:6433
Environment=GOMAXPROCS=1
ExecStart=/usr/local/lib/isureal/jpegworker
Nice=10
CPUWeight=10
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
