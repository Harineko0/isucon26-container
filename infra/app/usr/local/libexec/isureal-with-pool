#!/bin/bash
set -euo pipefail
# The primary DSN in env.sh is also used by init.sh and session-bound work.
export ISUREAL_APP_DB_POOL=192.168.1.10:6432
app=/home/isucon/webapp/go/isureal
if [[ $ISUREAL_REGION != asia ]]; then
  exec "$app"
fi

# Read the existing SCRAM verifier over the normal primary connection. It must
# be identical for PgBouncer to authenticate to PostgreSQL on the client's behalf.
# systemd creates the private runtime directory and removes it when the unit stops.
install -m 600 /dev/null "$RUNTIME_DIRECTORY/users.txt"
PGPASSWORD="$ISUREAL_DB_PASSWORD" PGCONNECT_TIMEOUT=3 psql -XAtqw -v ON_ERROR_STOP=1 \
  -h "$ISUREAL_DB_HOST" -p "$ISUREAL_DB_PORT" -U "$ISUREAL_DB_USER" -d "$ISUREAL_DB_NAME" \
  > "$RUNTIME_DIRECTORY/users.txt" <<'SQL'
SELECT '"' || replace(rolname, '"', '""') || '" "' || rolpassword || '"'
FROM pg_catalog.pg_authid
WHERE rolname = current_user AND rolpassword LIKE 'SCRAM-SHA-256$%';
SQL
test -s "$RUNTIME_DIRECTORY/users.txt"
/usr/local/lib/isureal/pgbouncer-1.26.1 /etc/isureal/pgbouncer.ini &
pool_pid=$!
for ((i=0; i<50; i++)); do
  kill -0 "$pool_pid" || exit 1
  if pg_isready -q -t 1 -h 192.168.1.10 -p 6432 -U "$ISUREAL_DB_USER" -d "$ISUREAL_DB_NAME"; then break; fi
  sleep 0.1
done
(( i < 50 )) || exit 1

"$app" &
# systemd's control group owns both children. Restart the pair if either exits.
wait -n "$pool_pid" "$!" || true
exit 1
