[Unit]
Description=isureal-go
After=network-online.target
Wants=network-online.target

[Service]
User=isucon
Group=isucon
WorkingDirectory=/home/isucon/webapp/go
EnvironmentFile=/home/isucon/env.sh
# Soft heap cap so the image cache plus GOGC=100 headroom cannot push asia1 into OOM.
# Above the observed peak (Sys 1.68 GB); see infra/notes/go-memlimit.md
Environment=GOMEMLIMIT=2GiB
Environment=ISUREAL_LISTEN_HOST=127.0.0.1
Environment=ISUREAL_APP_DB_POOL=192.168.4.10:6432
Environment=ISUREAL_ASIA_JPEG_WORKER=http://192.168.4.10:6433
Environment=ISUREAL_APP_DB_READ_NAME=isureal_reads
ExecStart=/home/isucon/webapp/go/isureal
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
