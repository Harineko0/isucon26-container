[Unit]
Description=isureal-go
After=network-online.target
Wants=network-online.target

[Service]
User=isucon
Group=isucon
WorkingDirectory=/home/isucon/webapp/go
EnvironmentFile=/home/isucon/env.sh
# Soft heap cap so the image cache plus GOGC=100 headroom cannot push asia1 into OOM.
# Above the observed peak (Sys 1.68 GB); see infra/notes/go-memlimit.md
Environment=GOMEMLIMIT=2GiB
ExecStart=/home/isucon/webapp/go/isureal
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
